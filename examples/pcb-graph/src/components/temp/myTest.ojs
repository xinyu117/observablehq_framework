 renderChart3 = (data, options = {}) => {
    options.color ||= (d, i) => color(i)

    const draw = svgjs('svgjs').size('100%', '700')
   //const rect = draw.rect(100, 100).attr({ fill: '#f06' });


    const tangleLayout = constructTangleLayout(lodash.cloneDeep(data), options);


  tangleLayout.bundles.map((b, i) => {
          let d = b.links.map(
            l => `
      M${l.xt} ${l.yt}
      L${l.xb - l.c1} ${l.yt}
      A${l.c1} ${l.c1} 90 0 1 ${l.xb} ${l.yt + l.c1}
      L${l.xb} ${l.ys - l.c2}
      A${l.c2} ${l.c2} 90 0 0 ${l.xb + l.c2} ${l.ys}
      L${l.xs} ${l.ys}`
          )
            .join("");

//draw.path(d).attr('stroke',background_color).attr('stroke-width',stroke_width).addClass('link');
draw.path(d).attr('stroke',options.color(b, i)).attr('stroke-width',2).addClass('link').on('click',test);

        })

 //   return rect;

 tangleLayout.nodes.forEach(n => {
     const nodeHeight = n.height + 8;
     draw.rect(8, nodeHeight).fill('white').move(n.x, (n.y - nodeHeight / 2)).stroke({ color: 'black', opacity: 0.9, width: 2 }).radius(4).addClass('selectable node');
  // draw.text(n.id).move(n.x + 12, (n.y - nodeHeight / 2 - 16)).on('click', test).tspan(n.id).newLine().addClass('tooltip').tspan("ddddddwwe").addClass('tooltiptext');
     draw.text(n.id).data('key', { value: { data: 0.3 }}).move(n.x + 12, (n.y - nodeHeight / 2 - 16)).on('click', test).on('mouseenter', function(event) {
        // 创建一个提示框元素
        var tooltip = document.createElement('div');
        tooltip.textContent = n.name ? n.name : 'This is an infotip!';

          tooltip.classList.add('tooltiptext');
        tooltip.style.left = (event.clientX + 10) + 'px';
        tooltip.style.top = (event.clientY + 10) + 'px';

        // 将提示框添加到文档中
        document.body.appendChild(tooltip);
